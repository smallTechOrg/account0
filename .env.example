# Copy to .env and fill in. Never commit .env.
ACCOUNT0_ANTHROPIC_API_KEY=
# Required by this key: sent as the `anthropic-workspace-id` header on every request.
ACCOUNT0_ANTHROPIC_WORKSPACE_ID=
# Optional overrides
# ACCOUNT0_PORT=8710
# ACCOUNT0_DATA_DIR=../data        (relative to backend/)
# ACCOUNT0_INBOX_DIR=../data/inbox (watched folder: drop PDFs/images here)
# Optional (Phase 8): Gmail/Drive import. Create an OAuth client of type "Web application" in Google Cloud Console,
# enable the Gmail API and Drive API, add redirect URI http://127.0.0.1:8710/api/google/callback, then:
# ACCOUNT0_GOOGLE_CLIENT_ID=
# ACCOUNT0_GOOGLE_CLIENT_SECRET=
# Optional: encrypt stored OAuth tokens with your own key (default: random key in data/.secret-key)
# ACCOUNT0_SECRET_KEY=
